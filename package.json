{
  "name": "remix-lambda-app",
  "version": "1.0.0",
  "description": "Simple Remix hello world app deployed to Lambda with CloudFront",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remix vite:dev",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "cdk:deploy": "cd infrastructure && cdk deploy",
    "cdk:synth": "cd infrastructure && cdk synth",
    "cdk:destroy": "cd infrastructure && cdk destroy"
  },
  "dependencies": {
    "@remix-run/node": "^2.12.0",
    "@remix-run/react": "^2.12.0",
    "@remix-run/serve": "^2.12.0",
    "@remix-run/server-runtime": "^2.12.0",
    "isbot": "^5.1.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.933.0",
    "@aws-sdk/client-sts": "^3.933.0",
    "@remix-run/dev": "^2.12.0",
    "@smithy/node-http-handler": "^4.4.5",
    "@types/aws-lambda": "^8.10.145",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "https-proxy-agent": "^7.0.6",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  }
}

{
  "name": "remix-lambda-app",
  "version": "1.0.0",
  "description": "Simple Remix hello world app deployed to Lambda with CloudFront",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remix vite:dev",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "cdk:deploy": "cd infrastructure && cdk deploy",
    "cdk:synth": "cd infrastructure && cdk synth",
    "cdk:destroy": "cd infrastructure && cdk destroy",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@remix-run/node": "^2.12.0",
    "@remix-run/react": "^2.12.0",
    "@remix-run/serve": "^2.12.0",
    "@remix-run/server-runtime": "^2.12.0",
    "@types/pdfkit": "^0.17.3",
    "dotenv": "^17.2.3",
    "isbot": "^5.1.32",
    "pdfkit": "^0.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-sts": "^3.933.0",
    "@playwright/test": "^1.57.0",
    "@remix-run/dev": "^2.12.0",
    "@smithy/node-http-handler": "^4.4.5",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.22",
    "https-proxy-agent": "^7.0.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  }
}

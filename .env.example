# HandyBid AI Environment Variables
# Copy this file to .env and fill in your actual values

# Anthropic API Key (required for AI estimate generation)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# AWS Region (optional - defaults to us-east-1)
AWS_REGION=us-east-1

# Photo bucket name (automatically set by CDK deployment)
# Leave commented for local development
# PHOTO_BUCKET_NAME=your-bucket-name-here
